@* @page "/register"
 *@
@using Microsoft.AspNetCore.Components.Forms
@using PpmV2.UI.Shared.Models
@using PpmV2.UI.Shared.Services
@using PpmV2.UI.Shared.Auth

@inject IAuthService AuthService
@inject NavigationManager Nav

<EditForm FormName="registerForm"
          Model="_model"
          OnSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="auth-container">
        <div class="auth-card">
            <h1>Konto erstellen</h1>
            <p class="auth-subtitle">Registriere dich mit deiner E-Mail</p>

            <div class="form-group">
                <label>Vorname</label>
                <InputText class="form-control" @bind-Value="_model.Firstname" />
                <ValidationMessage For="@(() => _model.Firstname)" />
            </div>

            <div class="form-group">
                <label>Nachname</label>
                <InputText class="form-control" @bind-Value="_model.Lastname" />
                <ValidationMessage For="@(() => _model.Lastname)" />
            </div>

            <div class="form-group">
                <label>E-Mail</label>
                <InputText class="form-control" @bind-Value="_model.Email" />
                <ValidationMessage For="@(() => _model.Email)" />
            </div>

            <div class="form-group">
                <label>Passwort</label>
                <InputText class="form-control" type="password" @bind-Value="_model.Password" />
                <ValidationMessage For="@(() => _model.Password)" />
            </div>

            <div class="form-group">
                <label>Passwort bestätigen</label>
                <InputText class="form-control" type="password" @bind-Value="_model.ConfirmPassword" />
                <ValidationMessage For="@(() => _model.ConfirmPassword)" />
            </div>

            @* Rolle – aktuell fix auf Honorarkraft (kein Feld im UI nötig).
               Später kannst du hier ein Dropdown für Admin-UI einbauen. *@

            <div class="form-group form-inline">
                <InputCheckbox @bind-Value="_model.AcceptTerms" />
                <span>Ich akzeptiere die Nutzungsbedingungen</span>
            </div>
            <ValidationMessage For="@(() => _model.AcceptTerms)" />

            <button type="submit" class="btn-primary" disabled="@_isBusy">
                @(_isBusy ? "Bitte warten..." : "Registrieren")
            </button>

            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <p class="text-error">@_errorMessage</p>
            }

            <p class="auth-footer">
                Bereits registriert?
                <a href="/login">Zum Login</a>
            </p>
        </div>
    </div>
</EditForm>

@code {
    private RegisterModel _model = new()
    {
        Role = UserRole.Honorarkraft
    };

    private bool _isBusy;
    private string? _errorMessage;

    private async Task HandleValidSubmit()
    {
        _errorMessage = null;
        _isBusy = true;

        var result = await AuthService.RegisterAsync(_model);

        _isBusy = false;

        if (result.Success)
        {
            // Später Snackbar/Toast, für jetzt Redirect:
            // Nav.NavigateTo("/login");
            Nav.NavigateTo("/login?registered=true");
        }
        else
        {
            _errorMessage = result.ErrorMessage ?? "Registrierung fehlgeschlagen.";
        }
    }
}
